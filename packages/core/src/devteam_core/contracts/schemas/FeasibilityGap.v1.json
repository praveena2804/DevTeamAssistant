{
  "$defs": {
    "GapCategory": {
      "description": "The 13 mandatory completeness-checklist categories (Spec §6.2).",
      "enum": [
        "goal",
        "actors",
        "features",
        "workflows",
        "data",
        "rules",
        "permissions",
        "login",
        "technology",
        "integrations",
        "deployment",
        "acceptance_criteria",
        "non_functional"
      ],
      "title": "GapCategory",
      "type": "string"
    },
    "GapKind": {
      "description": "Spec §6.2: conflicting, ambiguous, duplicate and missing statements.",
      "enum": [
        "missing",
        "unclear",
        "conflicting",
        "duplicate"
      ],
      "title": "GapKind",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Points at one extracted chunk (Part B). Page/section/paragraph are filled in by code.",
      "properties": {
        "chunk_id": {
          "pattern": "^chk_[0-9a-f]{26}$",
          "title": "Chunk Id",
          "type": "string"
        },
        "document_id": {
          "pattern": "^doc_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Document Id",
          "type": "string"
        },
        "page_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page End"
        },
        "page_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Start"
        },
        "paragraph_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph End"
        },
        "paragraph_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Start"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        }
      },
      "required": [
        "document_id",
        "chunk_id"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A gap the Feasibility Gate raises for the clarification form (Part I).\n\nNo criticality here: criticality is decided by the Requirements Policy Engine (Spec §5.4.2, Part I).",
  "properties": {
    "category": {
      "$ref": "#/$defs/GapCategory"
    },
    "description": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "gap_id": {
      "pattern": "^gap_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Gap Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/GapKind"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "maxItems": 50,
      "title": "Source Refs",
      "type": "array"
    }
  },
  "required": [
    "gap_id",
    "category",
    "kind",
    "description"
  ],
  "title": "FeasibilityGap",
  "type": "object"
}
