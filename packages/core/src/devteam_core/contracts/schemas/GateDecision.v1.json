{
  "$defs": {
    "ApprovalDecision": {
      "description": "F-4. 'Edit' is not a decision: it returns the draft for changes.",
      "enum": [
        "approved",
        "rejected",
        "cancelled"
      ],
      "title": "ApprovalDecision",
      "type": "string"
    },
    "GateName": {
      "description": "Human gate nodes (roadmap §6.5).",
      "enum": [
        "feasibility_decision",
        "clarification_form",
        "project_approval",
        "test_maintenance_approval",
        "publish_approval",
        "change_approval",
        "db_switch_approval"
      ],
      "title": "GateName",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A human decision submitted for the pending gate (validated by HC-13 before anything resumes).",
  "properties": {
    "comment": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Comment"
    },
    "decision": {
      "$ref": "#/$defs/ApprovalDecision"
    },
    "gate": {
      "$ref": "#/$defs/GateName"
    },
    "run_id": {
      "pattern": "^run_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "gate",
    "decision"
  ],
  "title": "GateDecision",
  "type": "object"
}
