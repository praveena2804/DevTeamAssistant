{
  "$defs": {
    "Provenance": {
      "enum": [
        "brd_fact",
        "user_answer",
        "assumption",
        "recommendation"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "RequirementPriority": {
      "description": "F-1 (MoSCoW). ``unspecified`` unless the BRD or the user states a priority.",
      "enum": [
        "must",
        "should",
        "could",
        "wont",
        "unspecified"
      ],
      "title": "RequirementPriority",
      "type": "string"
    },
    "RequirementStatus": {
      "description": "F-2: scope, not progress. Progress lives in RequirementEvidence.",
      "enum": [
        "extracted",
        "confirmed",
        "excluded",
        "blocked"
      ],
      "title": "RequirementStatus",
      "type": "string"
    },
    "RequirementType": {
      "enum": [
        "functional",
        "non_functional"
      ],
      "title": "RequirementType",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Points at one extracted chunk (Part B). Page/section/paragraph are filled in by code.",
      "properties": {
        "chunk_id": {
          "pattern": "^chk_[0-9a-f]{26}$",
          "title": "Chunk Id",
          "type": "string"
        },
        "document_id": {
          "pattern": "^doc_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Document Id",
          "type": "string"
        },
        "page_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page End"
        },
        "page_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Start"
        },
        "paragraph_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph End"
        },
        "paragraph_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Start"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        }
      },
      "required": [
        "document_id",
        "chunk_id"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer_id": {
      "anyOf": [
        {
          "pattern": "^ca_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Answer Id"
    },
    "description": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "priority": {
      "$ref": "#/$defs/RequirementPriority",
      "default": "unspecified"
    },
    "project_id": {
      "pattern": "^prj_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Project Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "rationale": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rationale"
    },
    "requirement_id": {
      "pattern": "^(FR|NFR)-[0-9]{3,4}$",
      "title": "Requirement Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "maxItems": 50,
      "title": "Source Refs",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/RequirementStatus",
      "default": "extracted"
    },
    "type": {
      "$ref": "#/$defs/RequirementType"
    }
  },
  "required": [
    "provenance",
    "requirement_id",
    "project_id",
    "type",
    "description"
  ],
  "title": "Requirement",
  "type": "object"
}
