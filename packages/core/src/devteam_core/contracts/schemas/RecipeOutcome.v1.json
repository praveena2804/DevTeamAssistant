{
  "$defs": {
    "SandboxExecutionStatus": {
      "enum": [
        "completed",
        "failed",
        "timed_out",
        "oom_killed",
        "blocked",
        "cancelled"
      ],
      "title": "SandboxExecutionStatus",
      "type": "string"
    },
    "TestCounts": {
      "additionalProperties": false,
      "properties": {
        "errors": {
          "minimum": 0,
          "title": "Errors",
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "passed": {
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "skipped": {
          "minimum": 0,
          "title": "Skipped",
          "type": "integer"
        },
        "tests": {
          "minimum": 0,
          "title": "Tests",
          "type": "integer"
        }
      },
      "required": [
        "tests",
        "passed",
        "failed",
        "errors",
        "skipped"
      ],
      "title": "TestCounts",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "duration_ms": {
      "default": 0,
      "minimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "execution_id": {
      "anyOf": [
        {
          "pattern": "^sbx_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execution Id"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Code"
    },
    "peak_memory_mb": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Peak Memory Mb"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "recipe": {
      "pattern": "^[a-z][a-z0-9_]{2,39}$",
      "title": "Recipe",
      "type": "string"
    },
    "reports_tests": {
      "default": false,
      "title": "Reports Tests",
      "type": "boolean"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/SandboxExecutionStatus"
    },
    "tests": {
      "anyOf": [
        {
          "$ref": "#/$defs/TestCounts"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "recipe",
    "status"
  ],
  "title": "RecipeOutcome",
  "type": "object"
}
