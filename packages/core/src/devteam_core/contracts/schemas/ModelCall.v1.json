{
  "$defs": {
    "AgentRole": {
      "description": "The ten agents, exactly (roadmap §4.1, ADR-0002). Adding an eleventh is prohibited.",
      "enum": [
        "brd_analyst",
        "requirements_finalizer",
        "head",
        "architect",
        "database_developer",
        "backend_developer",
        "frontend_developer",
        "tester",
        "debugger_reviewer",
        "documenter"
      ],
      "title": "AgentRole",
      "type": "string"
    },
    "ModelSlot": {
      "description": "Model slots (docs/architecture/MODEL_ROUTING.md; D-37 adds the optional ``review`` slot).",
      "enum": [
        "instruct",
        "coder",
        "review",
        "coder_large",
        "fallback",
        "embedding"
      ],
      "title": "ModelSlot",
      "type": "string"
    },
    "RecoveryStep": {
      "description": "Where on the recovery ladder a call ran (Spec §9.4; Part F plan §6.2).",
      "enum": [
        "none",
        "reduced_context",
        "smaller_model"
      ],
      "title": "RecoveryStep",
      "type": "string"
    },
    "RouteRule": {
      "description": "Which routing rule chose the model (MODEL_ROUTING §3.2); recorded on every ``ModelCall``.",
      "enum": [
        "operation",
        "agent",
        "slot",
        "global"
      ],
      "title": "RouteRule",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One model call (HC-05/GW-08), metadata only: **never prompt, input or answer text** (AC-F-01).\n\n``project_id`` is ``None`` only for platform service calls with no project (evaluation, inventory),\nas for ``audit_events``. Exactly one of ``agent`` or ``service`` names who called.",
  "properties": {
    "agent": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentRole"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "attempt": {
      "default": 1,
      "maximum": 10,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "cache_hit": {
      "default": false,
      "title": "Cache Hit",
      "type": "boolean"
    },
    "call_id": {
      "pattern": "^mcl_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Call Id",
      "type": "string"
    },
    "duration_ms": {
      "minimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "error_code": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_.]{1,60}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "free_ram_mb": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Free Ram Mb"
    },
    "input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Hash",
      "type": "string"
    },
    "input_tokens": {
      "minimum": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "kind": {
      "pattern": "^(generate|embed)$",
      "title": "Kind",
      "type": "string"
    },
    "model_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Digest"
    },
    "model_tag": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,80}(:[A-Za-z0-9._-]{1,40})?$",
      "title": "Model Tag",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^[a-z][a-z0-9_]{1,40}\\.[a-z][a-z0-9_]{1,60}$",
      "title": "Operation Id",
      "type": "string"
    },
    "outcome": {
      "pattern": "^(valid|invalid|error|refused)$",
      "title": "Outcome",
      "type": "string"
    },
    "output_tokens": {
      "minimum": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "project_id": {
      "anyOf": [
        {
          "pattern": "^prj_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "prompt_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Hash"
    },
    "prompt_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Id"
    },
    "prompt_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    },
    "recovery_step": {
      "$ref": "#/$defs/RecoveryStep",
      "default": "none"
    },
    "route_rule": {
      "$ref": "#/$defs/RouteRule"
    },
    "run_id": {
      "anyOf": [
        {
          "pattern": "^run_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "schema_name": {
      "anyOf": [
        {
          "pattern": "^[A-Z][A-Za-z0-9]{1,80}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Schema Name"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "service": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{1,40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Service"
    },
    "slot": {
      "$ref": "#/$defs/ModelSlot"
    },
    "task_id": {
      "anyOf": [
        {
          "pattern": "^tsk_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    }
  },
  "required": [
    "call_id",
    "kind",
    "operation_id",
    "slot",
    "model_tag",
    "route_rule",
    "input_hash",
    "input_tokens",
    "output_tokens",
    "duration_ms",
    "outcome"
  ],
  "title": "ModelCall",
  "type": "object"
}
