{
  "$defs": {
    "ArtifactType": {
      "description": "F-5. Set by the Controlled File Service from the write path, never by an agent.",
      "enum": [
        "document",
        "source_file",
        "test_file",
        "contract",
        "migration",
        "config",
        "report",
        "package"
      ],
      "title": "ArtifactType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "pattern": "^art_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "checksum": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Checksum",
      "type": "string"
    },
    "path": {
      "maxLength": 240,
      "title": "Path",
      "type": "string"
    },
    "project_id": {
      "pattern": "^prj_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "type": {
      "$ref": "#/$defs/ArtifactType"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "artifact_id",
    "project_id",
    "path",
    "type",
    "version",
    "checksum"
  ],
  "title": "Artifact",
  "type": "object"
}
