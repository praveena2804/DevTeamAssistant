{
  "$defs": {
    "FeasibilityStatus": {
      "description": "Spec §5.3.",
      "enum": [
        "supported",
        "supported_with_substitution",
        "partial",
        "not_supported"
      ],
      "title": "FeasibilityStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "alternative": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Alternative"
    },
    "item_id": {
      "pattern": "^fea_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Item Id",
      "type": "string"
    },
    "project_id": {
      "pattern": "^prj_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Project Id",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "requirement_id": {
      "pattern": "^(FR|NFR|BR)-[0-9]{3,4}$",
      "title": "Requirement Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/FeasibilityStatus"
    }
  },
  "required": [
    "item_id",
    "project_id",
    "requirement_id",
    "status"
  ],
  "title": "FeasibilityItem",
  "type": "object"
}
