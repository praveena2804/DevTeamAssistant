{
  "$defs": {
    "AgentRole": {
      "description": "The ten agents, exactly (roadmap §4.1, ADR-0002). Adding an eleventh is prohibited.",
      "enum": [
        "brd_analyst",
        "requirements_finalizer",
        "head",
        "architect",
        "database_developer",
        "backend_developer",
        "frontend_developer",
        "tester",
        "debugger_reviewer",
        "documenter"
      ],
      "title": "AgentRole",
      "type": "string"
    },
    "NodeName": {
      "description": "Every node of the ``project_run`` graph and its four subgraphs (Part D plan §3.2).",
      "enum": [
        "route_entry",
        "route_after_discovery",
        "route_after_change",
        "route_after_build",
        "finalize_run",
        "intake",
        "brd_analyst",
        "feasibility",
        "feasibility_decision",
        "requirements_finalizer",
        "clarification_form",
        "project_approval",
        "freeze_spec",
        "build_entry_guard",
        "head",
        "schedule",
        "architect",
        "database_developer",
        "backend_developer",
        "frontend_developer",
        "tester",
        "debugger_reviewer",
        "integration_build",
        "test_runner",
        "verify_task",
        "failure_router",
        "completion_gate_1",
        "documenter",
        "packager",
        "completion_gate_2",
        "publish_approval",
        "github_deployer",
        "final_report",
        "change_intake",
        "change_impact",
        "change_approval",
        "freeze_change_spec"
      ],
      "title": "NodeName",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The Head dispatcher's hand-off of one build task to its agent node (roadmap §4.3 rule 3).",
  "properties": {
    "agent_type": {
      "$ref": "#/$defs/AgentRole"
    },
    "attempt": {
      "maximum": 4,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "dispatched_at": {
      "format": "date-time",
      "title": "Dispatched At",
      "type": "string"
    },
    "done_criteria": {
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Done Criteria",
      "type": "array"
    },
    "idempotency_key": {
      "maxLength": 200,
      "title": "Idempotency Key",
      "type": "string"
    },
    "input_artifact_refs": {
      "default": [],
      "items": {
        "pattern": "^([a-z][a-z0-9]{1,11}_[0-7][0-9A-HJKMNP-TV-Z]{25}|chk_[0-9a-f]{26}|(FR|NFR|BR)-[0-9]{3,4})$",
        "type": "string"
      },
      "maxItems": 200,
      "title": "Input Artifact Refs",
      "type": "array"
    },
    "node": {
      "$ref": "#/$defs/NodeName"
    },
    "permitted_paths": {
      "default": [],
      "items": {
        "maxLength": 240,
        "type": "string"
      },
      "maxItems": 50,
      "title": "Permitted Paths",
      "type": "array"
    },
    "project_id": {
      "pattern": "^prj_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Project Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^run_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "task_id": {
      "pattern": "^tsk_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "run_id",
    "task_id",
    "agent_type",
    "node",
    "attempt",
    "idempotency_key",
    "done_criteria",
    "dispatched_at"
  ],
  "title": "DispatchRecord",
  "type": "object"
}
