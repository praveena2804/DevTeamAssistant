{
  "additionalProperties": false,
  "properties": {
    "actor": {
      "pattern": "(^agent:(brd_analyst|requirements_finalizer|head|architect|database_developer|backend_developer|frontend_developer|tester|debugger_reviewer|documenter):tsk_[0-7][0-9A-HJKMNP-TV-Z]{25}$)|(^service:[a-z][a-z0-9_]{1,40}$)|(^prn_[0-7][0-9A-HJKMNP-TV-Z]{25}$)",
      "title": "Actor",
      "type": "string"
    },
    "event_id": {
      "pattern": "^evt_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Event Id",
      "type": "string"
    },
    "kind": {
      "const": "metric.sampled",
      "default": "metric.sampled",
      "title": "Kind",
      "type": "string"
    },
    "metric": {
      "enum": [
        "free_ram_mb",
        "worker_rss_mb",
        "queue_depth"
      ],
      "title": "Metric",
      "type": "string"
    },
    "project_id": {
      "anyOf": [
        {
          "pattern": "^prj_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "run_id": {
      "anyOf": [
        {
          "pattern": "^run_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "task_id": {
      "anyOf": [
        {
          "pattern": "^tsk_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "value": {
      "minimum": 0,
      "title": "Value",
      "type": "integer"
    }
  },
  "required": [
    "event_id",
    "ts",
    "actor",
    "metric",
    "value"
  ],
  "title": "MetricSample",
  "type": "object"
}
