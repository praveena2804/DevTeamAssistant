{
  "additionalProperties": false,
  "description": "Points at one extracted chunk (Part B). Page/section/paragraph are filled in by code.",
  "properties": {
    "chunk_id": {
      "pattern": "^chk_[0-9a-f]{26}$",
      "title": "Chunk Id",
      "type": "string"
    },
    "document_id": {
      "pattern": "^doc_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Document Id",
      "type": "string"
    },
    "page_end": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Page End"
    },
    "page_start": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Page Start"
    },
    "paragraph_end": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Paragraph End"
    },
    "paragraph_start": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Paragraph Start"
    },
    "quote": {
      "anyOf": [
        {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quote"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "section": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Section"
    }
  },
  "required": [
    "document_id",
    "chunk_id"
  ],
  "title": "SourceRef",
  "type": "object"
}
