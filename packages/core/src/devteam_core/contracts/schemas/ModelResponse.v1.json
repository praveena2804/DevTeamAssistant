{
  "$defs": {
    "ModelUsage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "title": "ModelUsage",
      "type": "object"
    },
    "OutputValidation": {
      "additionalProperties": false,
      "properties": {
        "errors": {
          "default": [],
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Errors",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "valid"
      ],
      "title": "OutputValidation",
      "type": "object"
    },
    "Provider": {
      "enum": [
        "fake",
        "ollama"
      ],
      "title": "Provider",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "default": 1,
      "maximum": 4,
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "duration_ms": {
      "minimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "model_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Digest"
    },
    "model_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "output_text": {
      "maxLength": 60000,
      "title": "Output Text",
      "type": "string"
    },
    "parsed": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parsed"
    },
    "provider": {
      "$ref": "#/$defs/Provider"
    },
    "request_id": {
      "pattern": "^mrq_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "usage": {
      "$ref": "#/$defs/ModelUsage"
    },
    "validation": {
      "$ref": "#/$defs/OutputValidation"
    }
  },
  "required": [
    "request_id",
    "provider",
    "model_id",
    "output_text",
    "usage",
    "duration_ms",
    "validation"
  ],
  "title": "ModelResponse",
  "type": "object"
}
