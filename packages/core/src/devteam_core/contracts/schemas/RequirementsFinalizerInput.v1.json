{
  "additionalProperties": false,
  "properties": {
    "answers_submitted": {
      "default": false,
      "title": "Answers Submitted",
      "type": "boolean"
    },
    "critical_gap_ids": {
      "default": [],
      "items": {
        "pattern": "^gap_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "type": "string"
      },
      "maxItems": 500,
      "title": "Critical Gap Ids",
      "type": "array"
    },
    "feasibility_item_ids": {
      "default": [],
      "items": {
        "pattern": "^fea_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "type": "string"
      },
      "maxItems": 500,
      "title": "Feasibility Item Ids",
      "type": "array"
    },
    "gap_ids": {
      "default": [],
      "items": {
        "pattern": "^gap_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "type": "string"
      },
      "maxItems": 500,
      "title": "Gap Ids",
      "type": "array"
    },
    "project_id": {
      "pattern": "^prj_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Project Id",
      "type": "string"
    },
    "requirement_ids": {
      "default": [],
      "items": {
        "pattern": "^(FR|NFR|BR)-[0-9]{3,4}$",
        "type": "string"
      },
      "maxItems": 500,
      "title": "Requirement Ids",
      "type": "array"
    },
    "run_id": {
      "pattern": "^run_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "project_id",
    "run_id"
  ],
  "title": "RequirementsFinalizerInput",
  "type": "object"
}
