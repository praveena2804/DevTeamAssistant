          "maxLength": 20000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "project_id": {
          "pattern": "^prj_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Project Id",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "rationale": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "requirement_ids": {
          "items": {
            "pattern": "^(FR|NFR)-[0-9]{3,4}$",
            "type": "string"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Requirement Ids",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 50,
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "provenance",
        "criterion_id",
        "project_id",
        "requirement_ids",
        "description"
      ],
      "title": "AcceptanceCriterion",
      "type": "object"
