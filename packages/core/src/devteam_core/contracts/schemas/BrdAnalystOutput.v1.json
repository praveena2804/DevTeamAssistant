      "additionalProperties": false,
      "properties": {
        "answer_id": {
          "anyOf": [
            {
              "pattern": "^ca_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer Id"
