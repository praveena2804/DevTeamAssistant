{
  "$defs": {
    "Provenance": {
      "enum": [
        "brd_fact",
        "user_answer",
        "assumption",
        "recommendation"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Points at one extracted chunk (Part B). Page/section/paragraph are filled in by code.",
      "properties": {
        "chunk_id": {
          "pattern": "^chk_[0-9a-f]{26}$",
          "title": "Chunk Id",
          "type": "string"
        },
        "document_id": {
          "pattern": "^doc_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Document Id",
          "type": "string"
        },
        "page_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page End"
        },
        "page_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Start"
        },
        "paragraph_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph End"
        },
        "paragraph_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Start"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        }
      },
      "required": [
        "document_id",
        "chunk_id"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "TechnologyLayer": {
      "description": "Spec §6.2: frontend, backend, language, framework, runtime, database, auth, deployment.",
      "enum": [
        "frontend",
        "backend",
        "language",
        "framework",
        "runtime",
        "database",
        "authentication",
        "deployment",
        "other"
      ],
      "title": "TechnologyLayer",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer_id": {
      "anyOf": [
        {
          "pattern": "^ca_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Answer Id"
    },
    "layer": {
      "$ref": "#/$defs/TechnologyLayer"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "project_id": {
      "pattern": "^prj_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Project Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "rationale": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rationale"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "maxItems": 50,
      "title": "Source Refs",
      "type": "array"
    },
    "tech_id": {
      "pattern": "^tec_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Tech Id",
      "type": "string"
    },
    "version_spec": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Version Spec"
    }
  },
  "required": [
    "provenance",
    "tech_id",
    "project_id",
    "layer",
    "name"
  ],
  "title": "TechnologyNeed",
  "type": "object"
}
