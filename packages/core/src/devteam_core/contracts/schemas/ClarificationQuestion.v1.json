{
  "$defs": {
    "GapCategory": {
      "description": "The 13 mandatory completeness-checklist categories (Spec §6.2).",
      "enum": [
        "goal",
        "actors",
        "features",
        "workflows",
        "data",
        "rules",
        "permissions",
        "login",
        "technology",
        "integrations",
        "deployment",
        "acceptance_criteria",
        "non_functional"
      ],
      "title": "GapCategory",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Points at one extracted chunk (Part B). Page/section/paragraph are filled in by code.",
      "properties": {
        "chunk_id": {
          "pattern": "^chk_[0-9a-f]{26}$",
          "title": "Chunk Id",
          "type": "string"
        },
        "document_id": {
          "pattern": "^doc_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Document Id",
          "type": "string"
        },
        "page_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page End"
        },
        "page_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Start"
        },
        "paragraph_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph End"
        },
        "paragraph_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Start"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        }
      },
      "required": [
        "document_id",
        "chunk_id"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allow_not_needed": {
      "default": false,
      "title": "Allow Not Needed",
      "type": "boolean"
    },
    "allow_other": {
      "default": true,
      "title": "Allow Other",
      "type": "boolean"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "maxItems": 20,
      "title": "Evidence Refs",
      "type": "array"
    },
    "gap_id": {
      "pattern": "^gap_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Gap Id",
      "type": "string"
    },
    "impact_rank": {
      "maximum": 1000,
      "minimum": 1,
      "title": "Impact Rank",
      "type": "integer"
    },
    "options": {
      "default": [],
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Options",
      "type": "array"
    },
    "project_id": {
      "pattern": "^prj_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Project Id",
      "type": "string"
    },
    "prompt": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Prompt",
      "type": "string"
    },
    "question_id": {
      "pattern": "^cq_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Question Id",
      "type": "string"
    },
    "reason": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "topic": {
      "$ref": "#/$defs/GapCategory"
    }
  },
  "required": [
    "question_id",
    "project_id",
    "gap_id",
    "topic",
    "prompt",
    "reason",
    "impact_rank"
  ],
  "title": "ClarificationQuestion",
  "type": "object"
}
