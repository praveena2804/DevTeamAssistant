{
  "additionalProperties": false,
  "description": "A pointer to a secret in the OS keyring (HC-17). There is deliberately no value field.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "project_id": {
      "anyOf": [
        {
          "pattern": "^prj_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "ref": {
      "pattern": "^secret://(platform|prj_[0-9A-HJKMNP-TV-Z]{26})/[a-z][a-z0-9_.-]{0,63}$",
      "title": "Ref",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "secret_id": {
      "pattern": "^sec_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Secret Id",
      "type": "string"
    }
  },
  "required": [
    "secret_id",
    "name",
    "ref",
    "created_at"
  ],
  "title": "SecretReference",
  "type": "object"
}
