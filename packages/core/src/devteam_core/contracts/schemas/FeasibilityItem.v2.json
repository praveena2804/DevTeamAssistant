{
  "$defs": {
    "CatalogKey": {
      "description": "Every capability the platform knows. Adding one is a reviewed code change (enum + YAML + tests).",
      "enum": [
        "html_css_js",
        "react_vite",
        "angular",
        "vue",
        "power_apps_canvas",
        "fastapi_python",
        "dotnet",
        "java_spring",
        "power_automate",
        "sqlite",
        "postgresql_docker_local",
        "user_provided_postgresql",
        "supabase_hosted",
        "sql_server",
        "oracle",
        "azure_sql",
        "github_public_repo",
        "github_actions_ci",
        "github_pages",
        "power_apps",
        "azure",
        "aws",
        "sharepoint",
        "paid_hosting",
        "public_rest_no_credentials",
        "sso",
        "sap",
        "payment_gateway",
        "credentialed_api",
        "no_auth",
        "enterprise_identity_provider",
        "local_password_rbac"
      ],
      "title": "CatalogKey",
      "type": "string"
    },
    "FeasibilityGap": {
      "additionalProperties": false,
      "description": "A gap the Feasibility Gate raises for the clarification form (Part I).\n\nNo criticality here: criticality is decided by the Requirements Policy Engine (Spec §5.4.2, Part I).",
      "properties": {
        "category": {
          "$ref": "#/$defs/GapCategory"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "gap_id": {
          "pattern": "^gap_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Gap Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/GapKind"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 50,
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "gap_id",
        "category",
        "kind",
        "description"
      ],
      "title": "FeasibilityGap",
      "type": "object"
    },
    "FeasibilityStatus": {
      "description": "Spec §5.3.",
      "enum": [
        "supported",
        "supported_with_substitution",
        "partial",
        "not_supported"
      ],
      "title": "FeasibilityStatus",
      "type": "string"
    },
    "FeasibilitySubjectKind": {
      "description": "What a feasibility item is about (Spec §5.3: technology, integration, authentication, deployment).\n\nAuthentication and deployment needs are technology needs with that layer.",
      "enum": [
        "technology_need",
        "integration"
      ],
      "title": "FeasibilitySubjectKind",
      "type": "string"
    },
    "GapCategory": {
      "description": "The 13 mandatory completeness-checklist categories (Spec §6.2).",
      "enum": [
        "goal",
        "actors",
        "features",
        "workflows",
        "data",
        "rules",
        "permissions",
        "login",
        "technology",
        "integrations",
        "deployment",
        "acceptance_criteria",
        "non_functional"
      ],
      "title": "GapCategory",
      "type": "string"
    },
    "GapKind": {
      "description": "Spec §6.2: conflicting, ambiguous, duplicate and missing statements.",
      "enum": [
        "missing",
        "unclear",
        "conflicting",
        "duplicate"
      ],
      "title": "GapKind",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Points at one extracted chunk (Part B). Page/section/paragraph are filled in by code.",
      "properties": {
        "chunk_id": {
          "pattern": "^chk_[0-9a-f]{26}$",
          "title": "Chunk Id",
          "type": "string"
        },
        "document_id": {
          "pattern": "^doc_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Document Id",
          "type": "string"
        },
        "page_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page End"
        },
        "page_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Start"
        },
        "paragraph_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph End"
        },
        "paragraph_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Start"
        },
        "quote": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        }
      },
      "required": [
        "document_id",
        "chunk_id"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "SubstitutionState": {
      "description": "Offered by the Feasibility Gate; applied only with a verified, item-bound approval (AC-G-04).",
      "enum": [
        "none",
        "offered",
        "approved"
      ],
      "title": "SubstitutionState",
      "type": "string"
    },
    "TechnologyLayer": {
      "description": "Spec §6.2: frontend, backend, language, framework, runtime, database, auth, deployment.",
      "enum": [
        "frontend",
        "backend",
        "language",
        "framework",
        "runtime",
        "database",
        "authentication",
        "deployment",
        "other"
      ],
      "title": "TechnologyLayer",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "v2 (Part G, D-61): one item per subject (technology need or integration) with the requirements it\naffects. Spec §12's illustrative ``requirement_id`` is derivable: see ``RequirementEffect``.\n\nv1 (Part C) had one ``requirement_id`` per item and a free-text alternative; it was never stored.",
  "properties": {
    "alternative": {
      "anyOf": [
        {
          "$ref": "#/$defs/CatalogKey"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "catalog_key": {
      "anyOf": [
        {
          "$ref": "#/$defs/CatalogKey"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "gap": {
      "anyOf": [
        {
          "$ref": "#/$defs/FeasibilityGap"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "item_id": {
      "pattern": "^fea_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Item Id",
      "type": "string"
    },
    "layer": {
      "anyOf": [
        {
          "$ref": "#/$defs/TechnologyLayer"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "project_id": {
      "pattern": "^prj_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Project Id",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "report_id": {
      "pattern": "^fsr_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Report Id",
      "type": "string"
    },
    "requirement_ids": {
      "default": [],
      "items": {
        "pattern": "^(FR|NFR|BR)-[0-9]{3,4}$",
        "type": "string"
      },
      "maxItems": 500,
      "title": "Requirement Ids",
      "type": "array"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "maxItems": 50,
      "title": "Source Refs",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/FeasibilityStatus"
    },
    "subject_id": {
      "pattern": "^([a-z][a-z0-9]{1,11}_[0-7][0-9A-HJKMNP-TV-Z]{25}|chk_[0-9a-f]{26}|(FR|NFR|BR)-[0-9]{3,4})$",
      "title": "Subject Id",
      "type": "string"
    },
    "subject_kind": {
      "$ref": "#/$defs/FeasibilitySubjectKind"
    },
    "subject_name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Subject Name",
      "type": "string"
    },
    "substitution": {
      "$ref": "#/$defs/SubstitutionState",
      "default": "none"
    },
    "version_spec": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Version Spec"
    },
    "whole_application": {
      "default": false,
      "title": "Whole Application",
      "type": "boolean"
    }
  },
  "required": [
    "item_id",
    "project_id",
    "report_id",
    "subject_kind",
    "subject_id",
    "subject_name",
    "status"
  ],
  "title": "FeasibilityItem",
  "type": "object"
}
