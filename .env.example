# DevTeam AI — environment overrides (placeholders only; NEVER put real secrets here).
# Precedence: config/defaults.yaml < config/profiles/<profile>.yaml < .env < process environment.
# Nested keys use a double underscore: DEVTEAM_<SECTION>__<KEY>.

# Active profile: low_memory | standard | test
DEVTEAM_PROFILE=low_memory

# Platform API (loopback only)
DEVTEAM_API__HOST=127.0.0.1
DEVTEAM_API__PORT=8000

# Data locations (relative to the repository root)
DEVTEAM_PATHS__DATA_DIR=data
DEVTEAM_PATHS__WORKSPACES_DIR=workspaces

# Local model server — must be a loopback address (validated at startup)
DEVTEAM_OLLAMA__BASE_URL=http://127.0.0.1:11434

# Logging
DEVTEAM_LOGGING__LEVEL=INFO
