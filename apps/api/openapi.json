{
  "components": {
    "schemas": {
      "ComponentCheck": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ComponentCheck",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ComponentCheck"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "VersionResponse": {
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "profile": {
            "title": "Profile",
            "type": "string"
          },
          "python_version": {
            "title": "Python Version",
            "type": "string"
          },
          "schema_head": {
            "title": "Schema Head",
            "type": "string"
          },
          "schema_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Schema Revision"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "api_version",
          "python_version",
          "profile",
          "schema_revision",
          "schema_head"
        ],
        "title": "VersionResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Local-first platform API. Loopback only.",
    "title": "DevTeam AI Platform API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "One or more components are unhealthy"
          }
        },
        "summary": "Platform health",
        "tags": [
          "system"
        ]
      }
    },
    "/version": {
      "get": {
        "operationId": "version_version_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Platform version",
        "tags": [
          "system"
        ]
      }
    }
  }
}
